      "type": "string",
      "description": "Operator sign-on ID",
      "sensitive": false,
      "example": "teller1",
      "pattern": "[a-zA-Z0-9_]{1,32}"
    },
    "password": {
      "type": "string",
      "description": "Operator password",
      "sensitive": true,
      "example": null,
      "pattern": null
    },
    "member_id": {
      "type": "string",
      "description": "Member number as printed on statements",
      "sensitive": false,
      "example": "12345",
      "pattern": "[0-9]{1,10}"
    },
    "from_share": {
      "type": "string",
      "description": "Stable unique substring identifying the source share, e.g. 'S1 - Savings'",
      "sensitive": false,
      "example": "S1 - Savings",
      "pattern": null
    },
    "to_share": {
      "type": "string",
      "description": "Stable unique substring identifying the destination share, e.g. 'S2 - Checking'",
      "sensitive": false,
      "example": "S2 - Checking",
      "pattern": null
    },
    "amount": {
      "type": "string",
      "description": "Dollar amount to transfer",
      "sensitive": false,
      "example": "1.00",
      "pattern": "[0-9]+(\\.[0-9]{1,2})?"
    },
    "memo": {
      "type": "string",
      "description": "Transfer memo",
      "sensitive": false,
      "example": "counter credit",
      "pattern": null
    }
  },
  "outcomes": {
