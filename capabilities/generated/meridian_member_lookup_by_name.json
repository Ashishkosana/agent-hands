      "type": "string",
      "sensitive": false,
      "region": "identity",
      "from": {
        "ladder": [
          {
            "strategy": "relative",
            "relation": "cell_right",
            "anchor": {
              "strategy": "text",
              "text": "Member No.:"
            },
            "container": null
          }
        ],
        "context": [],
        "fingerprint": null,
        "fragile": false
      },
      "parse": {
        "kind": "text"
      }
