{
  "schema_version": 1,
  "name": "meridian_member_lookup_by_name",
  "version": 1,
  "description": "Sign on, search the member directory by LAST NAME, open the unique matching record, and return the member number and name.",
  "target": {
    "app": "meridian-core",
    "entry": {
      "web": {
        "url": "https://web-sample.interface-hiring.com/"
      }
    }
  },
  "requires": [
    {
      "kind": "role_name_visible",
      "role": "heading",
      "name": "OPERATOR SIGN ON",
      "context": []
    }
  ],
  "parameters": {
    "operator_id": {
      "type": "string",
      "description": "Operator sign-on ID",
      "sensitive": false,
      "example": "teller1",
      "pattern": "[a-zA-Z0-9_]{1,32}"
    },
    "password": {
      "type": "string",
      "description": "Operator password",
      "sensitive": true,
      "example": null,
      "pattern": null
    },
    "last_name": {
      "type": "string",
      "description": "Member surname to search",
      "sensitive": false,
      "example": "Lovelace",
      "pattern": "[A-Za-z'\\- ]{1,40}"
    }
  },
  "outcomes": {
    "MEMBER_NOT_FOUND": {
      "description": "No member matches this surname."
    }
  },
  "outputs": {
